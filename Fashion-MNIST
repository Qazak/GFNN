      "source": [
        "import numpy as np\n",
        "\n",
        "from tensorflow.keras.datasets import fashion_mnist\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score\n",
        ")\n",
        "\n",
        "# =====================================================\n",
        "# GFNN\n",
        "# =====================================================\n",
        "\n",
        "class GFNN:\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        initial_neurons=64,\n",
        "        growth_step=32,\n",
        "        max_neurons=512,\n",
        "        threshold=0.02\n",
        "    ):\n",
        "\n",
        "        self.initial_neurons = initial_neurons\n",
        "        self.growth_step = growth_step\n",
        "        self.max_neurons = max_neurons\n",
        "        self.threshold = threshold\n",
        "\n",
        "        self.model = None\n",
        "        self.growth_events = 0\n",
        "        self.final_neurons = initial_neurons\n",
        "\n",
        "    def fit(\n",
        "        self,\n",
        "        X_train,\n",
        "        y_train,\n",
        "        X_val,\n",
        "        y_val\n",
        "    ):\n",
        "\n",
        "        best_acc = -1.0\n",
        "        neurons = self.initial_neurons\n",
        "\n",
        "        while neurons <= self.max_neurons:\n",
        "\n",
        "            model = MLPClassifier(\n",
        "                hidden_layer_sizes=(neurons,),\n",
        "                activation=\"relu\",\n",
        "                solver=\"adam\",\n",
        "                max_iter=30,\n",
        "                early_stopping=True,\n",
        "                random_state=0\n",
        "            )\n",
        "\n",
        "            model.fit(X_train, y_train)\n",
        "\n",
        "            pred = model.predict(X_val)\n",
        "\n",
        "            acc = accuracy_score(y_val, pred)\n",
        "\n",
        "            if self.model is None:\n",
        "\n",
        "                self.model = model\n",
        "                self.final_neurons = neurons\n",
        "\n",
        "            if acc > best_acc:\n",
        "\n",
        "                best_acc = acc\n",
        "                self.model = model\n",
        "                self.final_neurons = neurons\n",
        "\n",
        "            if (1.0 - acc) <= self.threshold:\n",
        "                break\n",
        "\n",
        "            neurons += self.growth_step\n",
        "            self.growth_events += 1\n",
        "\n",
        "    def predict(self, X):\n",
        "\n",
        "        return self.model.predict(X)\n",
        "\n",
        "# =====================================================\n",
        "# LOAD FASHION-MNIST\n",
        "# =====================================================\n",
        "\n",
        "(X_train_full, y_train_full), (X_test, y_test) = \\\n",
        "    fashion_mnist.load_data()\n",
        "\n",
        "X_train_full = X_train_full.reshape(\n",
        "    len(X_train_full),\n",
        "    784\n",
        ").astype(\"float32\")\n",
        "\n",
        "X_test = X_test.reshape(\n",
        "    len(X_test),\n",
        "    784\n",
        ").astype(\"float32\")\n",
        "\n",
        "X_train_full /= 255.0\n",
        "X_test /= 255.0\n",
        "\n",
        "# =====================================================\n",
        "# STORAGE\n",
        "# =====================================================\n",
        "\n",
        "accs = []\n",
        "precs = []\n",
        "recs = []\n",
        "f1s = []\n",
        "\n",
        "growth_events = []\n",
        "final_neurons = []\n",
        "\n",
        "RUNS = 10\n",
        "\n",
        "for seed in range(RUNS):\n",
        "\n",
        "    print(f\"\\nRUN {seed+1}/{RUNS}\")\n",
        "\n",
        "    X_train, X_val, y_train, y_val = \\\n",
        "        train_test_split(\n",
        "            X_train_full,\n",
        "            y_train_full,\n",
        "            test_size=0.2,\n",
        "            stratify=y_train_full,\n",
        "            random_state=seed\n",
        "        )\n",
        "\n",
        "    gfnn = GFNN()\n",
        "\n",
        "    gfnn.fit(\n",
        "        X_train,\n",
        "        y_train,\n",
        "        X_val,\n",
        "        y_val\n",
        "    )\n",
        "\n",
        "    pred = gfnn.predict(X_test)\n",
        "\n",
        "    acc = accuracy_score(\n",
        "        y_test,\n",
        "        pred\n",
        "    )\n",
        "\n",
        "    prec = precision_score(\n",
        "        y_test,\n",
        "        pred,\n",
        "        average=\"macro\"\n",
        "    )\n",
        "\n",
        "    rec = recall_score(\n",
        "        y_test,\n",
        "        pred,\n",
        "        average=\"macro\"\n",
        "    )\n",
        "\n",
        "    f1 = f1_score(\n",
        "        y_test,\n",
        "        pred,\n",
        "        average=\"macro\"\n",
        "    )\n",
        "\n",
        "    accs.append(acc)\n",
        "    precs.append(prec)\n",
        "    recs.append(rec)\n",
        "    f1s.append(f1)\n",
        "\n",
        "    growth_events.append(\n",
        "        gfnn.growth_events\n",
        "    )\n",
        "\n",
        "    final_neurons.append(\n",
        "        gfnn.final_neurons\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Accuracy={acc:.4f} \"\n",
        "        f\"F1={f1:.4f}\"\n",
        "    )\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\"*60)\n",
        "print(\"FASHION-MNIST RESULTS\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(\"Accuracy Mean =\", np.mean(accs))\n",
        "print(\"Accuracy Std =\", np.std(accs))\n",
        "print(\"Precision Mean =\", np.mean(precs))\n",
        "print(\"Recall Mean =\", np.mean(recs))\n",
        "print(\"F1 Mean =\", np.mean(f1s))\n",
        "print(\"Average Growth Events =\", np.mean(growth_events))\n",
        "print(\"Average Final Neurons =\", np.mean(final_neurons))"
      ],
